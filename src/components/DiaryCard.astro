---
import { diary, socials } from '../config';
---

<article class="diary" data-diary>
  <p class="diary-meta">
    <span data-kicker>
      <span data-when="sheathed">{diary.sheathed.kicker}</span>
      <span data-when="unsheathed">{diary.unsheathed.kicker}</span>
    </span>
    <time datetime={diary.date}>{diary.dateLabel}</time>
  </p>

  <div class="diary-copy">
    <div class="diary-face" data-face="sheathed">
      <p class="hello">{diary.sheathed.hello}</p>
      <p class="name">{diary.sheathed.name}</p>
      <p class:list={['aside', { struck: diary.sheathed.struck }]}>{diary.sheathed.aside}</p>
      <p class="caption">{diary.sheathed.caption}</p>
    </div>
    <div class="diary-face" data-face="unsheathed">
      <p class="hello">{diary.unsheathed.hello}</p>
      <p class="name">{diary.unsheathed.name}</p>
      <p class:list={['aside', { struck: diary.unsheathed.struck }]}>{diary.unsheathed.aside}</p>
      <p class="caption">{diary.unsheathed.caption}</p>
    </div>
  </div>

  <nav class="socials" aria-label="链接">
    {
      socials.map((item) => (
        <a
          class="cta"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="erosion" aria-hidden="true"><span></span></div>
</article>
