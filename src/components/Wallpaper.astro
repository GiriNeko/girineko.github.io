---
import { wallpapers, type FormState } from '../config';

const forms = ['sheathed', 'unsheathed'] as const satisfies FormState[];
---

<div class="wallpaper" aria-hidden="true">
  {
    forms.map((form) => {
      const urls = wallpapers[form];
      return (
        <picture class={`wall-${form}`}>
          <source media={wallpapers.query} srcset={urls.mobile} type="image/webp" />
          <img
            src={urls.desktop}
            alt={urls.alt}
            width={urls.width}
            height={urls.height}
            decoding="async"
            loading={form === 'sheathed' ? 'eager' : 'lazy'}
            fetchpriority={form === 'sheathed' ? 'high' : 'low'}
          />
        </picture>
      );
    })
  }
</div>
