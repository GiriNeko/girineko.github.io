---
import Base from '../layouts/Base.astro';
import Wallpaper from '../components/Wallpaper.astro';
import DiaryCard from '../components/DiaryCard.astro';
import FormToggle from '../components/FormToggle';
import FlashToggle from '../components/FlashToggle';
import Atmosphere from '../components/Atmosphere';
---

<Base>
  <Wallpaper />
  <Atmosphere client:idle />

  <div class="stage">
    <header class="topbar">
      <FlashToggle client:load />
      <FormToggle client:load />
    </header>

    <main class="hero">
      <DiaryCard />
    </main>

    <footer class="site-footer">
      <p class="credit">Made with ❤ by GiriNeko</p>
      <p>
        本站由
        <a href="https://console.upyun.com/register/?invite=Byj3-zRKw">
          <img src="https://static.ineko.cc/icons/upyun_logo2.png" alt="又拍云" />
        </a>
        提供 CDN、云储存服务
      </p>
      <p>
        <a href="https://beian.miit.gov.cn" target="_blank" rel="noreferrer">赣ICP备 2020013131号</a>
        {' | '}
        <a href="https://icp.gov.moe" target="_blank" rel="noreferrer">萌ICP备</a>
        <a href="https://icp.gov.moe/?keyword=24682580" target="_blank" rel="noreferrer"> 24682580号</a>
      </p>
    </footer>
  </div>
</Base>
