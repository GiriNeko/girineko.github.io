---
import Base from '../layouts/Base.astro';
import Wallpaper from '../components/Wallpaper.astro';
import DiaryCard from '../components/DiaryCard.astro';
import FormToggle from '../components/FormToggle';
import FlashToggle from '../components/FlashToggle';
import AutoToggle from '../components/AutoToggle';
import Atmosphere from '../components/Atmosphere';
import WelcomeToast from '../components/WelcomeToast';
import { footer } from '../config';
---

<Base>
  <Wallpaper />
  <Atmosphere client:idle />
  <WelcomeToast client:load />

  <div class="stage">
    <header class="topbar">
      <div class="toggle-cluster">
        <AutoToggle client:load />
        <FlashToggle client:load />
      </div>
      <FormToggle client:load />
    </header>

    <main class="hero">
      <DiaryCard />
    </main>

    <footer class="site-footer">
      <p class="credit">{footer.credit}</p>
      <p>
        本站由
        <a href={footer.upyun.href}>
          <img src={footer.upyun.src} alt={footer.upyun.alt} />
        </a>
        提供 CDN、云储存服务
      </p>
      <p>
        <a href={footer.icp.href} target="_blank" rel="noreferrer">{footer.icp.label}</a>
        {' | '}
        <a href={footer.moe.href} target="_blank" rel="noreferrer">{footer.moe.label}</a>
        <a href={footer.moe.keyword} target="_blank" rel="noreferrer"> {footer.moe.number}</a>
      </p>
    </footer>
  </div>
</Base>
