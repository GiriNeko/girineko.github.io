---
import '../styles/global.css';
import { defaults, site, storageKeys, theme, wallpapers } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const boot = {
  keys: storageKeys,
  defaults,
  theme,
};
---

<!doctype html>
<html lang={site.lang} data-form="sheathed" data-flash={defaults.flash} data-auto={defaults.auto}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme.sheathed.color} />
    <title>{title}</title>
    <link rel="shortcut icon" href={site.favicon} />
    <link rel="preload" as="image" href={wallpapers.sheathed.desktop} media={`not ${wallpapers.query}`} />
    <link rel="preload" as="image" href={wallpapers.sheathed.mobile} media={wallpapers.query} />
    <script is:inline define:vars={{ boot }}>
      (function () {
        var root = document.documentElement;
        var auto = boot.defaults.auto;
        try {
          var savedAuto = localStorage.getItem(boot.keys.auto);
          if (savedAuto === 'on' || savedAuto === 'off') auto = savedAuto;
        } catch (e) {}
        root.dataset.auto = auto;
        var form = 'sheathed';
        try {
          if (auto === 'on') {
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) form = 'unsheathed';
          } else {
            var saved = localStorage.getItem(boot.keys.form);
            if (saved === 'sheathed' || saved === 'unsheathed') form = saved;
            else if (window.matchMedia('(prefers-color-scheme: dark)').matches) form = 'unsheathed';
          }
        } catch (e) {}
        var next = boot.theme[form];
        root.dataset.form = form;
        root.style.colorScheme = next.scheme;
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.setAttribute('content', next.color);
        var flash = boot.defaults.flash;
        try {
          var savedFlash = localStorage.getItem(boot.keys.flash);
          if (savedFlash === 'on' || savedFlash === 'off') flash = savedFlash;
        } catch (e) {}
        root.dataset.flash = flash;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
